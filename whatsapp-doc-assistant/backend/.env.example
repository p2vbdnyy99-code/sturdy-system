# ─── WhatsApp Document Assistant configuration ──────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ─── WhatsApp Cloud API (Meta) ──────────────────────────────────────────────
# Create an app at https://developers.facebook.com, add the "WhatsApp" product,
# and read these from the API Setup screen.

# Permanent (or temporary, for testing) access token for the WhatsApp Cloud API.
WHATSAPP_TOKEN=EAAG...your-cloud-api-token

# The phone number ID that sends/receives messages (NOT the display number).
WHATSAPP_PHONE_NUMBER_ID=1234567890

# A token you invent. Enter the same value in the Meta webhook config so Meta
# can verify it owns the webhook during the GET handshake.
WHATSAPP_VERIFY_TOKEN=pick-any-random-string

# App Secret from the Meta app dashboard. Used to verify the X-Hub-Signature-256
# header on incoming webhooks so only Meta can post to you. Optional but strongly
# recommended in production; leave blank to skip signature checks (dev only).
WHATSAPP_APP_SECRET=

# Graph API version to call. Bump as Meta releases new versions.
GRAPH_API_VERSION=v21.0

# ─── AI provider ────────────────────────────────────────────────────────────
# The app is provider-independent. Pick ONE provider; only that provider's API
# key is required. An unsupported value fails at startup (no silent fallback).
#
# Supported: openai | anthropic
AI_PROVIDER=openai

# Model id. Optional — defaults per provider (openai: gpt-5.6-terra,
# anthropic: claude-opus-5). Set to override with any model your account can use.
AI_MODEL=gpt-5.6-terra

# Provide the key for the selected provider only.
#   AI_PROVIDER=openai     → OPENAI_API_KEY
#   AI_PROVIDER=anthropic  → ANTHROPIC_API_KEY
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Per-request timeout for AI calls, in milliseconds (default 60000).
AI_TIMEOUT_MS=60000

# ─── Server ─────────────────────────────────────────────────────────────────
# HTTP port the webhook server listens on.
PORT=8788

# Directory for temporary document files (originals + generated .docx). It is
# created on boot and cleaned periodically. Keep it out of version control.
DATA_DIR=./data

# Reject documents larger than this (megabytes). WhatsApp itself caps documents
# at 100 MB; keep this lower to protect memory and API budgets.
MAX_PDF_MB=20

# Max pages whose text layer is extracted from a PDF (page-bomb / CPU guard).
MAX_PDF_PAGES=300

# Max tables written into a single generated .xlsx (bounds output/memory).
MAX_TABLES=50

# Hard wall-clock limit (ms) on one PDF→Word / PDF→Excel conversion.
CONVERSION_TIMEOUT_MS=45000

# How long (minutes) a user's most-recent document stays available for follow-up
# actions before the session is forgotten.
SESSION_TTL_MINUTES=60

# Max inbound messages processed per WhatsApp sender per minute (abuse/cost
# guard). Over-limit messages are dropped without an AI call or reply.
RATE_LIMIT_PER_MIN=20

# OPTIONAL: your own WhatsApp number (international format, digits only) to get
# a ping when a new user starts or a document is received. Best-effort —
# WhatsApp only delivers business-initiated messages inside a 24h window, so
# keep a chat open with the bot. Leave blank to disable owner pings.
OWNER_WHATSAPP=

# ─── OCR (scanned PDFs) ─────────────────────────────────────────────────────
# Pure Node/npm pipeline (pdf.js + @napi-rs/canvas + Tesseract.js) — no system
# binary required, so this works on hosts without apt access (e.g. Render free
# tier). Runs per PAGE: a mixed document (some digital pages, some scanned)
# uses the right method for each page. Never calls an AI provider.

# Rasterization resolution in DPI for pages sent to OCR. Higher = more
# accurate, slower.
OCR_DPI=200

# Cap OCR work per document so a huge scan can't stall the bot.
MAX_OCR_PAGES=15

# A PAGE with fewer than this many non-whitespace characters of real PDF text
# is treated as scanned and OCR'd.
SCANNED_CHARS_PER_PAGE=40

# Below this average Tesseract word confidence (0-100), OCR'd text is kept but
# the page is flagged to the user as low-confidence rather than silently
# trusted.
OCR_LOW_CONFIDENCE_THRESHOLD=45

# Wall-clock cap on extraction+OCR for one request. On expiry the OCR child
# process is killed and the user gets a friendly error. Separate from
# CONVERSION_TIMEOUT_MS because OCR scales with page count / image complexity.
OCR_TIMEOUT_MS=180000

# V8 old-space cap (MB) for the isolated OCR child process. OCR runs in its own
# process so a runaway page dies there — as a reportable error — instead of
# pushing the container past its memory limit and getting the whole server
# SIGKILLed. Keep this comfortably below the host's total memory.
OCR_MAX_HEAP_MB=256

# ─── Digital extraction isolation ───────────────────────────────────────────
# The span extractor decodes every page's embedded images, so a large
# image-heavy DIGITAL PDF can exhaust memory the same way a scan can. It runs
# in its own killable, heap-capped child process so a runaway parse dies there
# (a reportable error → friendly reply) instead of SIGKILLing the whole server.

# Wall-clock cap on one digital extraction. On expiry the child is killed and
# the user gets a friendly error. Smaller than OCR — digital parsing is faster.
EXTRACT_TIMEOUT_MS=120000

# V8 old-space cap (MB) for the isolated extraction child process.
EXTRACT_MAX_HEAP_MB=256

# ─── Metrics ────────────────────────────────────────────────────────────────
# The app logs content-free `metric …` lines (counts, sizes, timings) for beta
# analytics — never document text, filenames, or phone numbers.
#
# OPTIONAL: set a secret salt to enable counting DISTINCT users. With it set,
# each metric line carries a short HMAC of the sender (`user=<hash>`) instead of
# the phone number, so you can count unique users without storing any real
# identifier. Leave blank to disable the user tag entirely (default). MUST be a
# real secret if set — an unsalted/guessable value could be reversed, since the
# phone-number space is small.
METRICS_HASH_SALT=

# ─── AI spend caps (beta safety) ────────────────────────────────────────────
# The ONLY cost that scales with users is the AI provider (summary, Q&A,
# translate, explain, and intent-classify). These put a HARD ceiling on how many
# paid AI calls happen, so a beta can't run up a surprise bill even if you never
# set a limit in the provider dashboard. The free features (PDF→Word, PDF→Excel,
# OCR) use NO AI and are never capped — they keep working when the cap is hit.
#
# A value of 0 disables that dimension ("unlimited"). Defaults are beta-safe.
# Cost ≈ (calls) × (your model's per-call price); watch the ACTIONS block in
# `npm run digest` to see how many calls real usage drives.

# Max paid AI calls across ALL users per day (UTC). Default 500.
AI_DAILY_CALL_CAP=500

# Max paid AI calls across ALL users per month (UTC). Default 5000.
AI_MONTHLY_CALL_CAP=5000

# Max paid AI calls for ONE user per day (UTC), so a single enthusiastic tester
# can't drain the whole budget. Default 50.
AI_PER_USER_DAILY_CALL_CAP=50

# ─── BidPilot database (Postgres) ───────────────────────────────────────────
# Entirely separate product built on the same engine — see
# whatsapp-doc-assistant/BIDPILOT_ARCHITECTURE.md. Papyr (the WhatsApp path
# above) never reads these and keeps running with zero database whether or not
# this section is filled in.
#
# Local dev: point this at your own Postgres, never production. See
# BIDPILOT_ARCHITECTURE.md "Local development setup" for the one-time setup.
# Production (Render): create a Render PostgreSQL instance and paste its
# "Internal Database URL" here — set it directly in the Render dashboard's
# Environment tab, never in a committed file.
DATABASE_URL=postgres://user:password@localhost:5432/bidpilot_dev

# Max simultaneous Postgres connections this process holds open. Render runs
# this as one long-lived process, so a small fixed pool is enough — no
# external pooler (pgBouncer etc.) is needed at this scale. Default 10.
DATABASE_POOL_MAX=10

# ─── BidPilot file storage ───────────────────────────────────────────────────
# Tender PDFs are commercially sensitive: the database stores metadata + a
# reference key only, never the file bytes. See BIDPILOT_ARCHITECTURE.md
# "Storage decision" for the full rationale.

# 'local' for dev/testing (zero external dependencies — HMAC-signed URLs
# served by this app). 'local' is NOT viable in production: Render's standard
# web service disk is ephemeral and is wiped on every redeploy. Use 's3' for
# any real deployment.
BIDPILOT_STORAGE_DRIVER=local

# --- driver=local ---
# Where files are written. Defaults to <DATA_DIR>/bidpilot-files.
BIDPILOT_LOCAL_STORAGE_DIR=
# Required for 'local': secret used to sign download URLs. Generate a real
# random value — never reuse another secret in this file.
BIDPILOT_LOCAL_SIGNING_SECRET=
# This service's own public URL, used to build local signed download links.
# Defaults to http://localhost:$PORT for local dev.
BIDPILOT_PUBLIC_BASE_URL=

# --- driver=s3 --- (any S3-compatible provider: AWS S3, Cloudflare R2,
# Backblaze B2, Supabase Storage, ...)
BIDPILOT_S3_BUCKET=
BIDPILOT_S3_REGION=
# Leave blank for real AWS S3; set for a non-AWS S3-compatible provider.
BIDPILOT_S3_ENDPOINT=
BIDPILOT_S3_ACCESS_KEY_ID=
BIDPILOT_S3_SECRET_ACCESS_KEY=

# Reject tender uploads larger than this (default 50 — tenders can
# legitimately run hundreds of pages, larger than Papyr's WhatsApp cap).
BIDPILOT_MAX_UPLOAD_MB=50

# ─── BidPilot authentication (Milestone 3) ──────────────────────────────────
# Real email/password auth with server-side PostgreSQL sessions. See
# BIDPILOT_ARCHITECTURE.md "Milestone 3" for the full design.

# REQUIRED once BidPilot is in use. HMAC key for the CSRF double-submit
# cookie (src/bidpilot/auth/csrf.js). Generate a real random secret — e.g.
# `openssl rand -hex 32`. Auth routes refuse state-changing requests without
# this set.
BIDPILOT_CSRF_SECRET=

# Absolute session lifetime cap in days, regardless of activity. Default 30.
BIDPILOT_SESSION_TTL_DAYS=30

# Minimum minutes between session "last seen" writes — throttles the sliding
# idle timestamp so an active user doesn't cause a DB write on every request.
# Default 10.
BIDPILOT_SESSION_TOUCH_MINUTES=10

# How long an email-verification link stays valid, in hours. Default 24.
BIDPILOT_VERIFICATION_TOKEN_TTL_HOURS=24

# Explicit override for the session/CSRF cookie Secure flag. Normally
# auto-detected (true on Render / NODE_ENV=production, false otherwise, so
# local HTTP dev isn't broken by a cookie the browser would refuse to send
# back). Only set this for an unusual deployment shape.
# BIDPILOT_COOKIE_SECURE=true

# No transactional email provider is configured. In dev/non-production,
# registration returns the verification link directly in the API response
# (and logs it) instead of emailing it — see routes/auth.js. Production email
# delivery is a deliberate, later addition, not something to wire in quietly.

# ─── BidPilot external API access (Milestone 6) ─────────────────────────────
# A cross-origin caller (e.g. a Lovable-built frontend) authenticates with a
# SEPARATE, short-lived credential — never the 30-day browser session token.
# See auth/apiTokenService.js and BIDPILOT_ARCHITECTURE.md's Milestone 6.

# Comma-separated list of origins allowed to call the API cross-origin using
# an Authorization: Bearer <apiToken> header (see auth/cors.js). Empty/unset
# by default: no cross-origin requests are permitted. The existing same-
# origin cookie-based frontend needs no entry here and is unaffected either
# way.
BIDPILOT_CORS_ORIGINS=

# Lifetime of a short-lived API access token, in minutes. Default 20.
# Deliberately separate from BIDPILOT_SESSION_TTL_DAYS above — this token is
# only ever issued when a login request explicitly opts in
# ({ issueApiToken: true }), and is never the 30-day session token.
BIDPILOT_API_TOKEN_TTL_MINUTES=20

# Rolling-window cap on eligibility-check AI calls per company per day —
# its own cost center, separate from BIDPILOT_ANALYSIS_MAX_CALLS_PER_COMPANY_PER_DAY.
# Default 100.
BIDPILOT_ELIGIBILITY_MAX_CALLS_PER_COMPANY_PER_DAY=100

{
  "name": "whatsapp-doc-assistant",
  "version": "0.1.0",
  "description": "A WhatsApp AI document assistant: send a PDF to a WhatsApp number and summarize it, ask questions, OCR scanned pages, convert to Word, translate, and more — all inside the chat.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "benchmark": "node test/benchmark.mjs",
    "digest": "node scripts/digest.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@napi-rs/canvas": "^1.0.2",
    "argon2": "^0.45.1",
    "cookie": "^0.7.2",
    "docx": "^9.0.2",
    "dotenv": "^17.0.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.4.0",
    "openai": "^7.3.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "jszip": "^3.10.1",
    "pdfkit": "^0.19.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}

{
  "expo": {
    "name": "Adaptive Trader",
    "slug": "adaptive-trader",
    "scheme": "adaptivetrader",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0F14",
    "icon": "./assets/icon.png",
    "splash": { "backgroundColor": "#0B0F14" },
    "ios": {
      "bundleIdentifier": "com.example.adaptivetrader",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": { "ITSAppUsesNonExemptEncryption": false }
    },
    "web": { "bundler": "metro", "output": "single", "backgroundColor": "#0B0F14", "name": "Adaptive Trader" },
    "plugins": ["expo-router", "expo-secure-store", "expo-notifications"],
    "experiments": { "typedRoutes": false }
  }
}

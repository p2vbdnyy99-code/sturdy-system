# ---- required ---------------------------------------------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# JWT signing key, at least 32 characters:  openssl rand -hex 32
ATP_SECRET_KEY=
# Fernet key that encrypts broker secrets at rest:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ATP_CREDENTIALS_KEY=
# Browser origins allowed to call the API
ATP_CORS_ORIGINS=https://your-domain.example

# ---- optional ---------------------------------------------------------------
# Set to false after creating your own user (the first registered user becomes admin)
ATP_ALLOW_REGISTRATION=true
# Country of residence assumed for new users; drives the broker eligibility gate
ATP_DEFAULT_JURISDICTION=IN
# Real-time paper/live loop
ATP_RUN_TRADING_LOOP=true
ATP_TRADING_LOOP_SECONDS=5
# Quotes older than this many seconds halt new orders
ATP_QUOTE_STALE_SECONDS=90
ATP_BINANCE_BASE_URL=https://data-api.binance.vision
# Default MT5 bridge (private network address only) and its shared secret (= BRIDGE_SECRET on Windows)
ATP_MT5_BRIDGE_URL=
ATP_MT5_BRIDGE_SECRET=
# Optional AI wording of reports. The trading core never needs it.
ATP_ANTHROPIC_API_KEY=
ATP_AI_MODEL=claude-opus-5-5

# Shared secret with the backend (ATP_MT5_BRIDGE_SECRET or the connection's bridge_secret). >= 24 random chars.
BRIDGE_SECRET=
# Bind to a PRIVATE interface only (e.g. your Tailscale/WireGuard address). 127.0.0.1 = local only.
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_JOURNAL=orders.json
# Optional. Leave empty to use the account already logged in inside the terminal (recommended).
BRIDGE_MT5_PATH=
BRIDGE_MT5_LOGIN=
BRIDGE_MT5_PASSWORD=
BRIDGE_MT5_SERVER=

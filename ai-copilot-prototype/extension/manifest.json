{
  "manifest_version": 3,
  "name": "AI Copilot",
  "version": "0.1.0",
  "description": "A Notion-style AI copilot for the web: floating chat, text toolbar, command palette, sidebar, and smart form fill.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["http://localhost:8787/*"],
  "action": {
    "default_title": "AI Copilot",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-command-palette": {
      "suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
      "description": "Open the AI command palette"
    },
    "toggle-sidebar": {
      "suggested_key": { "default": "Ctrl+Shift+U", "mac": "Command+Shift+U" },
      "description": "Toggle the AI sidebar"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "css": ["styles.css"],
      "js": [
        "utils/storage.js",
        "utils/prompts.js",
        "utils/apiClient.js",
        "components/floatingButton.js",
        "components/textToolbar.js",
        "components/chatBox.js",
        "components/sidebar.js",
        "components/commandPalette.js",
        "components/formFill.js",
        "contentScript.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ]
}

# ─── AI Copilot backend configuration ───────────────────────────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Anthropic API key used by the proxy. All extension traffic is authenticated
# against this single server-side key — client keys are never exposed.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default model the proxy uses when the client does not request one.
# See https://platform.claude.com/docs for current model IDs.
DEFAULT_MODEL=claude-opus-5

# Secret used to sign JWTs. Use a long random string in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# How long an issued token stays valid.
JWT_EXPIRES_IN=7d

# HTTP port the server listens on.
PORT=8787

# Comma-separated list of allowed CORS origins. Use "*" only for local dev.
# For an unpacked MV3 extension this is typically the extension origin, e.g.
#   chrome-extension://<your-extension-id>
CORS_ORIGINS=*

# Credits granted to each newly registered account.
SIGNUP_CREDITS=100

# Approximate credit cost charged per 1,000 output tokens. The proxy meters
# real token usage returned by the API and converts it into credits.
CREDITS_PER_1K_OUTPUT=1

# Optional path to a JSON file for persisting users/credits across restarts.
# If unset, all state lives in memory and is lost on restart (fine for demos).
DATA_FILE=./data/store.json
